{
  "name": "dsh-purge",
  "version": "2.3.42-dsh022",
  "description": "DeepSeek Harness 全量破甲版：无靶场限制、无外挂拦截、无授权弹窗。88 条宿主补丁 + 提示词注入 + 无限制预设 + 拒绝重试 + 注入探针。Jailbreak for every model — full-unrestricted build.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-COMMERCIAL.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.ja.md",
    "release-notes.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs",
    "test": "node --test",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L1daye/dsh-purge-nolimit.git"
  },
  "homepage": "https://github.com/L1daye/dsh-purge-nolimit#readme",
  "bugs": {
    "url": "https://github.com/L1daye/dsh-purge-nolimit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/L1daye/dsh-purge-nolimit/releases/download/v2.3.42-dsh022/dsh-purge-nolimit-2.3.42-dsh022.tar.gz",
      "zip": "https://github.com/L1daye/dsh-purge-nolimit/archive/refs/tags/v2.3.42-dsh022.zip",
      "git": "https://github.com/L1daye/dsh-purge-nolimit.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1",
  "dshTargets": [
    "0.2.2-rc.1",
    "0.2.2-rc.2",
    "0.2.2-rc.3"
  ],
  "dshCompatibility": {
    "dsh": ">=0.2.1-rc.1 <0.3.0",
    "runtime": {
      "host": "Electron 44 自带 Node 24.21.0（实测 rc.1 与 rc.3 相同）",
      "systemNodeForTooling": ">=22.5 —— redteam 资产库用 node:sqlite，低于此版本 7 个模块会在 import 阶段失败",
      "note": "scripts/selfcheck.mjs 与 bin/dsh-purge.js 用系统 node 跑时，运行时和宿主不是同一个；redteam 相关结论必须以宿主运行时为准"
    },
    "verified": {
      "0.2.2-rc.1": "Windows desktop: 86 applied / 2 skipped (#76 #80, by design) / 0 na / 0 drift / idempotent; panel 74/74",
      "0.2.2-rc.3": "Windows desktop: 81 applied / 3 skipped (#56 #76 #80) / 4 na (#30 #31 #64 #65 hooks packages not shipped upstream) / 0 drift / idempotent; panel 71/71"
    },
    "unknown": [
      "0.2.2-rc.2",
      "0.2.2-alpha.2",
      "0.2.1-rc.4"
    ]
  },
  "author": {
    "name": "L1daye",
    "email": "lidayet94@gmail.com",
    "url": "https://github.com/L1daye"
  },
  "contributors": [
    {
      "name": "YuJunZhiXue",
      "url": "https://github.com/YuJunZhiXue",
      "comment": "original dsh-purge: architecture, patch engine, prompt system"
    },
    {
      "name": "kingcharleslzy-ai",
      "url": "https://github.com/kingcharleslzy-ai",
      "comment": "community fork (MIT): refusal-retry, atomic-files, probe, backup guards"
    },
    {
      "name": "c3cvld7aag",
      "url": "https://github.com/c3cvld7aag",
      "comment": "fujiang-dsh: reference for refusal-marker design (idea only)"
    },
    {
      "name": "L1daye",
      "url": "https://github.com/L1daye",
      "comment": "maintainer of this full-unrestricted fork"
    }
  ]
}
